# Public base URL used for canonical links, Open Graph URLs, structured data, robots.txt and sitemap.xml.
# An origin only (no path). Production builds default to https://dev-tools.emadilramzan.workers.dev when
# unset and fail on localhost or non-HTTPS values; `next dev` defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://dev-tools.emadilramzan.workers.dev
